# ========================================================
# ReelsBot Standalone Python Configuration (.env)
# ========================================================

# 1. Telegram Bot Token & Security
# Get your bot token from @BotFather on Telegram (free)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Restrict bot strictly to your Telegram Chat ID.
# Leave blank on first run, and the bot will reply with your chat.id in Telegram and terminal!
ALLOWED_CHAT_ID=

# 2. 100% Free AI Caption Engine Configuration
# Supported providers: 'groq' (Recommended), 'gemini', or 'pollinations' (Zero-key test fallback)
AI_PROVIDER=groq

# Primary Free Provider: Groq Cloud API (Free tier has 14,400 req/day for qwen/qwen3.8-27b)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Secondary Free Provider: Google Gemini API (Free tier for gemini-3.5-flash)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 3. Cloudinary Video Hosting (Free Unsigned Preset)
# Sign up free at https://cloudinary.com
# Go to Settings > Upload > Upload presets > Add upload preset > Signing mode: 'Unsigned'
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name

# 4. Buffer GraphQL Instagram Reel Scheduling
# Connect your Instagram Business/Creator profile at https://buffer.com
# Generate an access token at https://buffer.com/developers/api
BUFFER_API_KEY=your_buffer_access_token_here

# Your Buffer Instagram Channel ID (run `python3 reels_bot.py --discover-buffer` to find it automatically!)
# You can also pass comma-separated IDs to cross-post: "id1, id2"
BUFFER_CHANNEL_ID=your_buffer_channel_id_here

# 5. Scheduling & Timezone Preferences
# IANA Timezone (e.g. Asia/Kolkata, America/New_York, Europe/London, UTC)
TIMEZONE=Asia/Kolkata

# Scheduled Post Time (24h format). Set POST_HOUR=-1 for instant scheduling (now + 3 minutes)
POST_HOUR=19
POST_MINUTE=0

# Max Reel duration in seconds (Instagram Reels limit is 90s)
MAX_REEL_DURATION_SEC=90

# 6. Viral Copywriting & Branding
BRAND_NAME=Sigma Mindset
BRAND_VOICE=stoic, commanding, psychologically insightful, concise
CREDIT_CREATOR=yes
